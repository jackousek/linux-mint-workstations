-- Managed by Ansible.
-- Used only for initial Pokladna PostgreSQL bootstrap.

\connect postgres

DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1
        FROM pg_catalog.pg_roles
        WHERE rolname = 'pokladna'
    ) THEN
        CREATE ROLE pokladna;
    END IF;
END
$$;

ALTER ROLE pokladna WITH
    NOSUPERUSER
    NOINHERIT
    NOCREATEROLE
    NOCREATEDB
    LOGIN
    NOREPLICATION
    NOBYPASSRLS
    PASSWORD '{{ vault_postgres_pokladna_password_hash }}';

CREATE DATABASE pokladna
    WITH
    OWNER = pokladna
    TEMPLATE = template0
    ENCODING = 'UTF8'
    LOCALE_PROVIDER = libc
    LOCALE = 'en_US.UTF-8';

